PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_secret
# Sandbox BUSINESS accounts that receive money for each demo store (Developer Dashboard > Sandbox Accounts)
GREENLEAF_PAYEE_EMAIL=
NORTHSIDE_PAYEE_EMAIL=
# auto: try paying the merchant directly, else capture to PayCodes then pay out to the merchant (Payouts API)
SETTLEMENT=auto
# --- PYUSD escrow rail (optional). Without these the escrow runs in simulated mode. TESTNET KEYS ONLY. ---
ESCROW_WINDOW_SECONDS=120          # simulated refund window
SEPOLIA_RPC_URL=
ESCROW_ADDRESS=                    # from contracts/paycode-escrow deploy
PYUSD_ADDRESS=0xCaC524BcA292aaade2DF8A05cC58F0a65B1B3bB9
PAYER_KEY=                         # wallet that pays in PYUSD (e.g. the AI agent's wallet)
ARBITER_KEY=                       # deployer / arbiter wallet
GREENLEAF_WALLET=
NORTHSIDE_WALLET=
GREENLEAF_WALLET_KEY=              # optional: lets the demo trigger merchant refunds
NORTHSIDE_WALLET_KEY=

# --- Claude (AI intent check + shopping agent). Without a key, payments on codes with an intent wait for you. ---
# Either OpenRouter (used first if set) or Anthropic directly.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# AI_PROVIDER=openrouter            # or anthropic, to choose when both keys are set
# AI_AUDIT_MODEL=anthropic/claude-haiku-5.5    # OpenRouter slugs; Anthropic direct uses claude-haiku-5-5
# AI_AGENT_MODEL=anthropic/claude-sonnet-5.5
# --- PayPal webhooks: Developer Dashboard > your app > Webhooks, URL https://<public host>/webhooks/paypal,
#     events PAYMENT.CAPTURE.REFUNDED, PAYMENT.CAPTURE.REVERSED, CUSTOMER.DISPUTE.CREATED. Unset = webhooks refused. ---
PAYPAL_WEBHOOK_ID=
# --- Guards and holds ---
# HOLD_MODE=app                     # app: a held payment reserves the code's budget only (default)
#                                   # authorize: also places a PayPal authorization; approve = capture, reject = void
# CATALOG_CHECK=1                   # basket lines must match the shop's catalog prices (0 to switch off)
# DUPLICATE_WINDOW_SECONDS=60       # decline an identical payment repeated within this many seconds (0 = off)
# --- Evidence signing (Ed25519). Unset = a key file evidence_signing_key.pem is created on first run (git-ignored). ---
# EVIDENCE_SIGNING_KEY=             # base64 of a 32-byte raw private key, for a deployed server
# --- Where agent.py / mcp_server.py find the running ScopePay server ---
SCOPEPAY_URL=http://localhost:8001
